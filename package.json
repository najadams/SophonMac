{
  "name": "sophon",
  "version": "1.0.0",
  "description": "Sophon - Advanced Business Management System",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"pnpm run dev:frontend\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "dev:frontend": "pnpm --filter sophon-frontend run dev",
    "prebuild": "node scripts/prepare-build.js",
    "build": "electron-builder",
    "postbuild": "node scripts/verify-build.js",
    "build:win": "pnpm run build -- --win --publish=never",
    "build:mac": "pnpm run build -- --mac --publish=never",
    "build:mac-arm64": "pnpm run build -- --mac --arm64 --publish=never",
    "build:linux": "pnpm run build -- --linux --publish=never",
    "clean": "rimraf dist out backend/node_modules",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Najm Adams",
  "license": "ISC",
  "dependencies": {
    "bindings": "^1.5.0",
    "chromium-pickle-js": "^0.2.0",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^8.0.1",
    "cross-env": "^7.0.3",
    "electron": "^37.7.0",
    "electron-builder": "^26.0.12",
    "fs-extra": "^11.1.1",
    "rimraf": "^5.0.5",
    "vite": "^7.1.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.sophon.pos",
    "productName": "Sophon",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "backend/**/*",
      "!backend/package-lock.json",
      "!backend/npm-debug.log*",
      "!backend/.DS_Store",
      "!**/.git",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/npm-debug.log"
    ],
    "extraResources": [
      {
        "from": "frontend/dist",
        "to": "frontend-dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "backend/**/*",
      "backend/node_modules/**/*"
    ],
    "beforePack": "scripts/before-pack.js",
    "afterPack": "scripts/after-pack.js",
    "icon": "resources/icon.png",
    "mac": {
      "icon": "resources/icon.icns",
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "win": {
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
